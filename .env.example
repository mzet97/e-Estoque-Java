# e-Estoque-Java — variáveis de ambiente (placeholders apenas; NÃO commitar valores reais)

# Banco de dados
EESTOQUE_DB_URL=jdbc:postgresql://localhost:5432/e-estoque
EESTOQUE_DB_USERNAME=postgres
EESTOQUE_DB_PASSWORD=change-me

# RabbitMQ
EESTOQUE_RABBITMQ_HOST=localhost
EESTOQUE_RABBITMQ_PORT=5672
EESTOQUE_RABBITMQ_USERNAME=change-me
EESTOQUE_RABBITMQ_PASSWORD=change-me

# Redis
EESTOQUE_REDIS_HOST=localhost
EESTOQUE_REDIS_PORT=6379
EESTOQUE_REDIS_PASSWORD=change-me

# Keycloak
EESTOQUE_KEYCLOAK_URL=http://localhost:8080
EESTOQUE_KEYCLOAK_REALM=e-estoque
EESTOQUE_KEYCLOAK_CLIENT_ID=e-estoque-client
EESTOQUE_KEYCLOAK_CLIENT_SECRET=change-me
EESTOQUE_KEYCLOAK_ISSUER=http://localhost:8080/realms/e-estoque
